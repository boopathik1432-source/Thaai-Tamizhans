rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🏆 THAAI TAMIZHANS KABADDI CLUB - CLOUD FIRESTORE RULES
    // Allows seamless live read/write for all club tables & real-time sync
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
