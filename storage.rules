rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match Notice posters, athlete photos, squad strategy PDFs, training videos
    match /{allPaths=**} {
      // Anyone on the squad / web app can read & preview media
      allow read: if true;
      // Allow upload (limit file size to 50MB for video/docs, image uploads)
      allow write: if request.resource.size < 50 * 1024 * 1024;
    }
  }
}
